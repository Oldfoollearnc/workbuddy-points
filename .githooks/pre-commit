#!/bin/sh
# 每次提交自动递增 version.json 的修订号（v1.2.3 -> v1.2.4）并加入本次提交。
# 为何放在仓库里：core.hooksPath 指向 .githooks，克隆后只需执行一次
#   git config core.hooksPath .githooks
# 即可让所有人共用同一套版本规则；hook 本身也随仓库版本化。
set -e

FILE="version.json"
[ -f "$FILE" ] || exit 0

CUR=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FILE" | head -n 1)
[ -n "$CUR" ] || exit 0

MAJ=$(echo "$CUR" | cut -d. -f1)
MIN=$(echo "$CUR" | cut -d. -f2)
PAT=$(echo "$CUR" | cut -d. -f3)
[ -n "$MAJ" ] || MAJ=1
[ -n "$MIN" ] || MIN=0
[ -n "$PAT" ] || PAT=0
PAT=$((PAT + 1))
NEW="$MAJ.$MIN.$PAT"

printf '{\n  "version": "%s",\n  "updated": "%s"\n}\n' "$NEW" "$(date +%Y-%m-%d)" > "$FILE"
git add "$FILE"
echo "[version] $CUR -> $NEW"
